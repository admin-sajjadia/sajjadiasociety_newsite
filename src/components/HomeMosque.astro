---
// Home page section for the Sajjadia Mosque project: progress, a concept
// rendering, and buttons to give or to see the full plans.
// Light background so it stands apart from the navy footer below it.
// Hidden when "Campaign Active?" is switched off in Sanity.
// Shows the first photo of the newest "Concept renderings" album, labeled as
// a rendering. Without a rendering, the progress bar takes the right column.
import CampaignProgress from "@/components/CampaignProgress.astro";
import { getAlbums } from "@/data/sanityQueries";
import { photoAlt, photoCropped, type Album } from "@/lib/albums";

interface Props {
  campaign: any;
}

const { campaign } = Astro.props;

const show = Boolean(campaign) && campaign.isActive !== false;
const raised = campaign?.raisedAmount ?? 0;
const goal = campaign?.goalAmount ?? 0;

const renderingAlbums: Album[] = show ? await getAlbums(["renderings"]) : [];
const renderingAlbum = renderingAlbums.find((a) => (a.photos?.length ?? 0) > 0);
const renderingPhoto = renderingAlbum?.photos?.[0];
const rendering = renderingPhoto
  ? {
      ...photoCropped(renderingPhoto, 800, 600),
      alt: photoAlt(renderingPhoto, renderingAlbum!, 0),
      lqip: renderingPhoto.asset?.metadata?.lqip,
    }
  : null;

// Gold: a giving button. It opens the Mosque tab on Support Us, where people choose an amount.
const GIVE_BTN =
  "inline-flex min-h-12 items-center justify-center rounded-lg bg-give px-6 font-semibold text-give-foreground " +
  "transition-colors hover:bg-give/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring " +
  "focus-visible:ring-offset-2";
const PLANS_BTN =
  "inline-flex min-h-12 items-center justify-center rounded-lg border border-primary px-6 font-semibold text-primary " +
  "transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 " +
  "focus-visible:ring-ring focus-visible:ring-offset-2";
---

{show && (
  <section
    class="layout-full border-t border-border bg-card py-14 text-foreground md:py-16"
    aria-labelledby="home-mosque-title"
  >
    <div class="layout-base">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="home-mosque-title" class="text-3xl text-foreground md:text-4xl">
            {campaign.title}
          </h2>
          {campaign.tagline && (
            <p class="mt-3 max-w-xl text-lg text-muted-foreground">{campaign.tagline}</p>
          )}

          {rendering && goal > 0 && (
            <div class="mt-8 max-w-xl">
              <CampaignProgress raised={raised} goal={goal} tone="light" />
            </div>
          )}

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/donate#mosque" class={GIVE_BTN}>Support the Mosque</a>
            <a href="/sajjadia-mosque" class={PLANS_BTN}>See the plans and progress</a>
          </div>
        </div>

        <!-- The alt text already says "Concept rendering", so the visible label is hidden from screen readers -->
        {rendering ? (
          <div class="relative overflow-hidden rounded-xl">
            <img
              src={rendering.src}
              srcset={rendering.srcset}
              sizes="(min-width: 1024px) 50vw, 100vw"
              alt={rendering.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full bg-muted bg-cover bg-center object-cover"
              style={rendering.lqip ? `background-image: url(${rendering.lqip})` : undefined}
            />
            <span
              class="absolute left-3 top-3 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-white"
              aria-hidden="true"
            >
              Concept rendering
            </span>
          </div>
        ) : (
          goal > 0 && <CampaignProgress raised={raised} goal={goal} tone="light" />
        )}
      </div>
    </div>
  </section>
)}
